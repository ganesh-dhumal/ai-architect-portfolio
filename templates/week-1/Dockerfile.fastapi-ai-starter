# Production-grade Dockerfile for FastAPI AI Starter System

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY README.md ./

RUN pip install --upgrade pip

RUN pip install \
    fastapi \
    uvicorn \
    pydantic \
    pydantic-settings \
    httpx \
    pytest \
    pytest-asyncio \
    ruff \
    black \
    mypy

COPY . .

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD [
    "uvicorn",
    "fastapi_ai_service_template:app",
    "--host",
    "0.0.0.0",
    "--port",
    "8000"
]
